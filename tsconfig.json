{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": false,
    "importHelpers": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "ES2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types",
      "./src/typings"
    ],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "paths": {
      "src/*": [
        "./src/*"
      ]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
